{
  "name": "dearlog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server:dev": "tsx server/index.ts",
    "server:worker": "tsx server/worker.ts",
    "db:generate": "prisma generate --schema server/prisma/schema.prisma",
    "db:migrate": "tsx server/prisma/init.ts",
    "db:seed": "tsx server/prisma/seed.ts",
    "db:studio": "prisma studio --schema server/prisma/schema.prisma",
    "build": "vite build",
    "preview": "vite preview",
    "backup:data": "node scripts/backup-local-data.mjs",
    "pilot:public:check": "node scripts/pilot-public-health.mjs",
    "pilot:cloudflare:check": "node scripts/pilot-public-health.mjs",
    "pilot:ngrok:check": "node scripts/pilot-ngrok-health.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.1.14",
    "@types/supertest": "^7.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.2",
    "lucide-react": "^0.546.0",
    "multer": "^2.2.0",
    "openai": "^4.20.0",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "supertest": "^7.2.2",
    "tailwind-merge": "^3.5.0",
    "uuid": "^14.0.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "fast-check": "^4.7.0",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.5"
  }
}
