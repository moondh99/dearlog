generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                  @id @default(uuid())
  name                   String
  phoneNumber            String?                 @unique
  role                   String
  birthDate              String?
  birthDecade            String?
  preferredName          String?
  seniorName             String?
  seniorBirthDecade      String?
  seniorPreferredName    String?
  guardianName           String?
  guardianRelationship   String?
  guardianPreferredName  String?
  profileImageUrl        String?
  recordSpaceName        String?
  recordSpaceCoverUrl    String?
  hasCurrentJob          Boolean?
  occupation             String?
  hometown               String?
  schoolHistory          String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  seniorLinks            GuardianSeniorLink[]    @relation("GuardianLinks")
  guardianLinks          GuardianSeniorLink[]    @relation("SeniorLinks")
  createdQuestions       Question[]              @relation("QuestionCreator")
  seniorQuestions        Question[]              @relation("QuestionSenior")
  seniorSchedules        InterviewSchedule[]     @relation("SeniorSchedules")
  guardianSchedules      InterviewSchedule[]     @relation("GuardianSchedules")
  interviewSessions      InterviewSession[]
  interviewRecords       InterviewRecord[]
  freeSpeechRecords      FreeSpeechRecord[]
  photos                 Photo[]
  pushSubscriptions      PushSubscription[]
  notifications          Notification[]          @relation("NotificationRecipient")
  relatedNotifications   Notification[]          @relation("NotificationRelatedUser")
  coverDesigns           CoverDesign[]
  publicationDraftCaches PublicationDraftCache[] @relation("PublicationDraftSenior")
  publicationRequests    PublicationRequest[]    @relation("PublicationSenior")
  requestedPublications  PublicationRequest[]    @relation("PublicationRequester")
  publicationPreviewJobs PublicationPreviewJob[] @relation("PublicationPreviewJobSenior")
  requestedPreviewJobs   PublicationPreviewJob[] @relation("PublicationPreviewJobRequester")
  legacyVault            LegacyVault?
  memories               Memory[]
  autobiographyDraft     AutobiographyDraft?
  calendarEvents         CalendarEvent[]
}

model GuardianSeniorLink {
  id           String   @id @default(uuid())
  guardianId   String
  seniorId     String
  relationship String?
  createdAt    DateTime @default(now())
  guardian     User     @relation("GuardianLinks", fields: [guardianId], references: [id], onDelete: Cascade)
  senior       User     @relation("SeniorLinks", fields: [seniorId], references: [id], onDelete: Cascade)

  @@unique([guardianId, seniorId])
}

model Chapter {
  id             String             @id
  order          Int                @unique
  title          String
  slug           String             @unique
  minAnswerCount Int                @default(15)
  questions      Question[]
  sessions       InterviewSession[]
  records        InterviewRecord[]
  freeSpeech     FreeSpeechRecord[]
}

model Question {
  id             String    @id @default(uuid())
  category       String
  text           String
  chapterId      String?
  seniorId       String?
  photoId        String?
  createdById    String?
  status         String    @default("pending")
  createdAt      DateTime  @default(now())
  answeredAt     DateTime?
  answerRecordId String?

  anonymous      Boolean @default(false)
  priority       String  @default("normal")
  answerMemoryId String?

  chapter   Chapter?           @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  senior    User?              @relation("QuestionSenior", fields: [seniorId], references: [id], onDelete: SetNull)
  photo     Photo?             @relation(fields: [photoId], references: [id], onDelete: SetNull)
  createdBy User?              @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  records   InterviewRecord[]
  sessions  InterviewSession[]

  @@index([seniorId, category, createdAt])
}

model Photo {
  id              String     @id @default(uuid())
  userId          String
  fileKey         String
  fileName        String
  mimeType        String
  metadataJson    String     @default("{}")
  analysisJson    String     @default("{}")
  linkedMemoryIds String     @default("[]")
  uploadedAt      DateTime   @default(now())
  // 목적별 동의. 사진은 챗봇 근거로 쓰이지 않아 chatbot은 두지 않는다.
  // 집행 지점이 없는 컬럼을 만드는 것이 애초에 이 문제를 만들었다.
  publish         Boolean    @default(true)
  familyRead      Boolean    @default(true)
  posthumous      Boolean    @default(true)
  sensitive       Boolean    @default(true)
  // 동의를 마지막으로 바꾼 시각. InterviewRecord와 같은 이유로 둔다.
  consentUpdatedAt DateTime?
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions       Question[]
}

model InterviewSchedule {
  id          String   @id @default(uuid())
  seniorId    String
  guardianId  String
  scheduledAt DateTime
  timezone    String   @default("Asia/Seoul")
  status      String   @default("scheduled")
  callSid     String?
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  senior      User     @relation("SeniorSchedules", fields: [seniorId], references: [id], onDelete: Cascade)
  guardian    User     @relation("GuardianSchedules", fields: [guardianId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id                String             @id @default(uuid())
  seniorId          String
  chapterId         String
  mode              String
  status            String             @default("active")
  currentQuestionId String?
  startedAt         DateTime           @default(now())
  endedAt           DateTime?
  pausedAt          DateTime?
  senior            User               @relation(fields: [seniorId], references: [id], onDelete: Cascade)
  chapter           Chapter            @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  currentQuestion   Question?          @relation(fields: [currentQuestionId], references: [id], onDelete: SetNull)
  records           InterviewRecord[]
  freeSpeech        FreeSpeechRecord[]
}

model InterviewRecord {
  id                String            @id @default(uuid())
  userId            String
  chapterId         String
  questionId        String?
  sessionId         String?
  audioFileKey      String
  transcriptText    String
  aiSummary         String?
  recordedAt        DateTime          @default(now())
  source            String            @default("app")
  mode              String            @default("photo")
  // 목적별 동의. 예전에는 5종 동의가 운영에서 생성되지 않는 Memory 테이블에 붙어 있어
  // 화면은 있는데 조작할 대상이 없었다. 실제 답변이 쌓이는 이 테이블로 옮긴다.
  // 상태는 불리언이다. 기존 3상태의 needs_review는 동의 상태가 아니라 검수 워크플로이고,
  // 아래 reviewStatus가 이미 그 역할을 한다.
  publish           Boolean           @default(true)
  chatbot           Boolean           @default(true)
  familyRead        Boolean           @default(true)
  posthumous        Boolean           @default(true)
  sensitive         Boolean           @default(true)
  // 동의를 마지막으로 바꾼 시각. 이 표에는 updatedAt이 없고, 있었더라도 본문 수정까지
  // 갱신돼 멀쩡한 PDF를 막았을 것이다. 이미 만들어진 산출물이 철회 전 내용인지 판단하는 데 쓴다.
  consentUpdatedAt  DateTime?
  reviewStatus      String            @default("pending")
  reviewedAt        DateTime?
  reviewRequestText String?
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter           Chapter           @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  question          Question?         @relation(fields: [questionId], references: [id], onDelete: SetNull)
  session           InterviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  freeSpeechRecord  FreeSpeechRecord?
}

model FreeSpeechRecord {
  id             String            @id @default(uuid())
  userId         String
  chapterId      String
  sessionId      String?
  audioFileKey   String
  transcriptText String
  recordedAt     DateTime          @default(now())
  // 이 행은 InterviewRecord의 사본이다. 동의 컬럼을 여기에도 두면 진실의 원천이 둘이 되어
  // 한쪽만 철회되는 우회로가 생긴다. 원본을 가리키고 동의는 원본에서 읽는다.
  interviewRecordId String?        @unique
  interviewRecord   InterviewRecord? @relation(fields: [interviewRecordId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter        Chapter           @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  session        InterviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@map("free_speech_db")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id            String    @id @default(uuid())
  userId        String
  relatedUserId String?
  type          String
  title         String
  body          String
  metadataJson  String?
  status        String    @default("unread")
  createdAt     DateTime  @default(now())
  readAt        DateTime?
  user          User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  relatedUser   User?     @relation("NotificationRelatedUser", fields: [relatedUserId], references: [id], onDelete: SetNull)
}

model AiProxyAuditLog {
  id             String   @id @default(uuid())
  userId         String
  role           String
  endpoint       String
  model          String?
  outcome        String
  statusCode     Int
  estimatedUnits Int      @default(0)
  latencyMs      Int      @default(0)
  providerStatus Int?
  providerCode   String?
  errorMessage   String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([endpoint, outcome, createdAt])
}

model CoverDesign {
  id                     String                  @id @default(uuid())
  userId                 String
  palette                String
  template               String
  font                   String
  analysisJson           String                  @default("{}")
  confirmedAt            DateTime?
  createdAt              DateTime                @default(now())
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicationDraftCaches PublicationDraftCache[]
  publicationRequests    PublicationRequest[]
  publicationPreviewJobs PublicationPreviewJob[]
}

model PublicationRequest {
  id            String                 @id @default(uuid())
  userId        String
  requestedById String
  coverDesignId String?
  draftCacheId  String?
  format        String                 @default("A5")
  status        String                 @default("requested")
  pdfFileKey    String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User                   @relation("PublicationSenior", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy   User                   @relation("PublicationRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  coverDesign   CoverDesign?           @relation(fields: [coverDesignId], references: [id], onDelete: SetNull)
  draftCache    PublicationDraftCache? @relation(fields: [draftCacheId], references: [id], onDelete: SetNull)
}

model PublicationDraftCache {
  id                  String               @id @default(uuid())
  userId              String
  coverDesignId       String?
  format              String               @default("A5")
  sourceHash          String
  editorialPlanJson   String
  writingDraftJson    String
  manifestJson        String
  html                String
  generatedBy         String               @default("fallback")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation("PublicationDraftSenior", fields: [userId], references: [id], onDelete: Cascade)
  coverDesign         CoverDesign?         @relation(fields: [coverDesignId], references: [id], onDelete: SetNull)
  publicationRequests PublicationRequest[]
  previewJobs         PublicationPreviewJob[]

  @@unique([userId, format, sourceHash, generatedBy])
  @@index([userId, format, sourceHash, generatedBy])
}

model PublicationPreviewJob {
  id            String                 @id @default(uuid())
  userId        String
  requestedById String
  coverDesignId String?
  draftCacheId  String?
  format        String                 @default("A5")
  sourceHash    String
  toneProfileJson String?
  status        String                 @default("queued")
  stage         String                 @default("cache_check")
  attemptCount  Int                    @default(0)
  errorCode     String?
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  user          User                   @relation("PublicationPreviewJobSenior", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy   User                   @relation("PublicationPreviewJobRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  coverDesign   CoverDesign?           @relation(fields: [coverDesignId], references: [id], onDelete: SetNull)
  draftCache    PublicationDraftCache? @relation(fields: [draftCacheId], references: [id], onDelete: SetNull)

  @@index([userId, format, sourceHash, status])
  @@index([status, updatedAt])
}

model LegacyVault {
  id                     String  @id @default(uuid())
  seniorId               String  @unique
  isVaultSetup           Boolean @default(false)
  encryptedMemories      String? // 암호화된 비공개 기억 백업 JSON
  encryptedAutobiography String? // 암호화된 자서전 백업 JSON
  serverShare            String? // JSON string representing Share B
  institutionShare       String? // JSON string representing Share C

  isDeceased               Boolean @default(false)
  deathVerificationStatus  String  @default("alive") // "alive", "pending_verification", "released"
  serverShareReleased      Boolean @default(false)
  institutionShareReleased Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senior User @relation(fields: [seniorId], references: [id], onDelete: Cascade)
}

model Memory {
  id                 String   @id @default(uuid())
  userId             String
  date               DateTime @default(now())
  topic              String
  originalTranscript String
  cleanedTranscript  String
  publishVersion     String
  privacy            String   @default("private")
  confidenceLabel    String   @default("확인됨")
  contradictions     String   @default("[]")

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags            MemoryTag[]
  consentSettings MemoryConsentSettings?
  vectorEntry     MemoryVectorEntry?
}

model MemoryTag {
  id       String @id @default(uuid())
  memoryId String
  category String // "people", "places", "emotions", "timePeriod"
  value    String
  memory   Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
}

model MemoryConsentSettings {
  memoryId   String @id
  publish    String @default("granted")
  familyRead String @default("granted")
  chatbot    String @default("granted")
  posthumous String @default("granted")
  sensitive  String @default("granted")
  memory     Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
}

model MemoryVectorEntry {
  memoryId      String @id
  embeddingJson String
  text          String
  memory        Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
}

model AutobiographyDraft {
  id             String    @id @default(uuid())
  userId         String    @unique
  structureJson  String    @default("{}")
  narrativesJson String    @default("[]")
  lastGenerated  DateTime?
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarEvent {
  id             String   @id @default(uuid())
  userId         String
  eventType      String
  eventDate      String
  relatedPersons String   @default("[]")
  recipientId    String   @default("family-group")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id         String    @id @default(uuid())
  token      String    @unique
  guardianId String
  seniorId   String    @unique
  expiresAt  DateTime?
  revokedAt  DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
