DATABASE_URL="file:../data/dearlog.db"
# For a Cloudflare Quick Tunnel pilot, set APP_URL and LOCAL_SERVER_PUBLIC_URL
# to the current https://*.trycloudflare.com URL, set VITE_ALLOWED_HOSTS to
# that host only, and keep VITE_NGROK_HOST empty.
APP_URL="http://localhost:8787"
LOCAL_SERVER_PORT="8787"
LOCAL_SERVER_PUBLIC_URL="http://localhost:8787"
# AUTH_TOKEN_SECRET은 반드시 채워야 합니다. 비어 있으면 로그인이 503으로 실패합니다.
# 예전에는 NODE_ENV가 production이 아니면 공개된 고정 시크릿으로 조용히 대체됐습니다.
AUTH_TOKEN_SECRET=""
AUTH_TOKEN_TTL_SECONDS="2592000"
# 켜면 x-user-* 헤더로 아무 계정이나 사칭할 수 있습니다. 테스트 실행 외에는 켜지 마세요.
ALLOW_DEV_AUTH_HEADERS="false"
# 발표용 데모 화면(/settings)은 로그인 없이 역할을 바꿀 수 있어 기본으로 꺼져 있습니다.
VITE_ENABLE_DEMO_SETTINGS="false"
FILE_ACCESS_TOKEN_TTL_SECONDS="600"
VITE_LOCAL_API_URL=""
VITE_ALLOWED_HOSTS=""
VITE_ALLOW_DEV_AUTH_HEADERS="false"
VITE_NGROK_HOST=""
VITE_USE_NGROK_HMR="false"
FACTCHAT_API_KEY=""
FACTCHAT_BASE_URL="https://factchat-cloud.mindlogic.ai/v1/gateway"
FACTCHAT_CHAT_MODEL="gpt-5-mini"
FACTCHAT_VISION_MODEL=""
FACTCHAT_WRITING_MODEL=""
OPENAI_API_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:local@dearlog.test"
