# Required only when testing real OpenAI API calls.
# Do not commit a real key. Copy this file to .env locally.
OPENAI_API_KEY="replace_with_your_openai_api_key"

# Optional: public app URL used by deployment/tunnel scripts.
APP_URL="http://localhost:3000"

# Optional: comma-separated Vite dev-server allowed hosts.
# Example: VITE_ALLOWED_HOSTS="example.ngrok-free.app"
VITE_ALLOWED_HOSTS=""
